{
  "name": "@inventory/db",
  "version": "1.0.0",
  "description": "Database layer for Inventory Management System using Prisma",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./client": {
      "import": "./dist/src/client.js",
      "types": "./dist/src/client.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "prisma"
  ],
  "scripts": {
    "db:push": "npx dotenv -e ../../../.env -- prisma db push --url %DATABASE_URL%",
    "db:migrate": "npx dotenv -e ../../../.env -- prisma migrate dev --url %DATABASE_URL%",
    "db:migrate:deploy": "npx dotenv -e ../../../.env -- prisma migrate deploy --url %DATABASE_URL%",
    "db:seed": "npx dotenv -e ../../../.env -- node --loader ts-node/esm prisma/seed.ts",
    "db:studio": "npx dotenv -e ../../../.env -- prisma studio --url %DATABASE_URL%",
    "db:generate": "prisma generate",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "echo 'No tests configured for db package' && exit 0"
  },
  "dependencies": {
    "@prisma/client": "^7.2.0"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^8.0.0",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2"
  }
}
