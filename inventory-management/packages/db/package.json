{
  "name": "@inventory/db",
  "version": "1.0.0",
  "description": "Database layer for Inventory Management System using Prisma",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "prisma"
  ],
  "scripts": {
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node --loader ts-node/esm prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@prisma/client": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
