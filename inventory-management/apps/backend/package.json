{
  "name": "backend",
  "version": "1.0.0",
  "description": "Fastify REST API for Inventory Management System",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --loader ts-node/esm --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@inventory/contracts": "workspace:*",
    "@inventory/db": "workspace:*",
    "fastify": "^5.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "ts-node": "^10.9.2",
    "vitest": "^2.1.8"
  }
}
